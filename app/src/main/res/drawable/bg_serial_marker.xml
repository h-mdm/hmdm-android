<?xml version="1.0" encoding="utf-8"?>
<!-- Accent dot with a soft halo, shown before "Robot Serial No:" -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/launcherAccentHalo"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/launcherAccent"/>
        </shape>
    </item>
</layer-list>
